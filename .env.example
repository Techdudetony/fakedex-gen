# Claude writes the dex entries. Without it, the app uses placeholder text.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Gemini draws the fakemon. Without it, the app uses placeholder images.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Supabase stores entries and images. Without these, entries are saved to .data/ locally.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set this before deploying publicly: the whole site then asks for this password (any username).
FAKEDEX_PASSWORD=
